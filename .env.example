DATABASE_URL=file:./dev.db
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379

# Password recovery email (development logs reset links if no key is configured).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Signal <onboarding@resend.dev>

# Optional OAuth providers (buttons appear when both values are configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional public search proxy (defaults to DuckDuckGo HTML).
SEARCH_ENGINE_URL=

# Optional external SMTP worker; receives { domain, mxHost, candidates }.
SMTP_WORKER_URL=
SMTP_WORKER_TOKEN=

# Direct SMTP is attempted by default. Configure a real HELO identity and sender domain before production use.
SMTP_PROBING_ENABLED=true
SMTP_HELO_DOMAIN=mail.verify-service.com
SMTP_FROM_ADDRESS=check@verify-service.com
SMTP_TIMEOUT_MS=5000

# Optional fallback: set a provider and its API key.
FALLBACK_PROVIDER=
MILLIONVERIFIER_API_KEY=
ZEROBOUNCE_API_KEY=
HUNTER_API_KEY=